# ──────────────────────────────────────────────────────────────────
# Lab Billing License API — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ──────────────────────────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Admin API Key — set a long random secret for production
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# Ed25519 Signing Keys — generated on first boot and printed to stdout.
# Copy the generated values here (single line, \n escaped) for persistence.
PRIVATE_KEY_PEM=
PUBLIC_KEY_PEM=

# Directory where licensedb.json is stored (defaults to ./data)
# DATA_DIR=/app/data

# CORS: Comma-separated allowed origins for browser clients
# ALLOWED_ORIGINS=https://medilab-admin.web.app,https://medilab-admin.firebaseapp.com
ALLOWED_ORIGINS=
